{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#course/*": "./scripts/course/*"
  },
  "scripts": {
    "course:generate": "node scripts/course/generate-course.mts",
    "dev": "pnpm course:generate && next dev",
    "build": "pnpm course:generate && next build",
    "start": "next start",
    "lint": "pnpm course:generate && eslint",
    "typecheck": "pnpm course:generate && next typegen && tsc --noEmit",
    "test": "pnpm course:generate && vitest run"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@types/mdx": "^2.0.14",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
